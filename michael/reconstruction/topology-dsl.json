{
  "schema": 1,
  "name": "Nickelle Bounded Topology DSL",
  "purpose": "Allow autonomous exterior reconstruction without arbitrary runtime code generation.",
  "ownerTruthRequired": true,
  "maxOperationsPerComponent": 24,
  "maxNewVerticesPerComponent": 4096,
  "maxComponentDrawBatches": 12,
  "allowedPrimitives": {
    "rounded_rect_ring": {"uses":["lamp_housing","grille_frame","bumper_opening","tail_lamp"],"parameters":["center","size","cornerRadius","thickness","depth"]},
    "rounded_rect_cavity": {"uses":["grille","lamp_cavity","bumper_duct"],"parameters":["center","size","cornerRadius","depth"]},
    "quad_strip": {"uses":["drl","splitter","skirt","wing_plane","trim"],"parameters":["points","thickness","depth"]},
    "box_bevel": {"uses":["lens","scoop","duct","hardware"],"parameters":["center","size","bevel"]},
    "fin_array": {"uses":["diffuser","vent","louver"],"parameters":["origin","count","spacing","size","sweep"]},
    "arch_layer": {"uses":["front_arch","rear_arch","quarter_aero"],"parameters":["center","radius","width","height","flare","sweep"]},
    "mesh_panel": {"uses":["grille_mesh","hood_vent","bumper_vent"],"parameters":["boundary","rows","columns","depth"]},
    "wing_element": {"uses":["rear_wing","canard"],"parameters":["span","chord","camber","height","sweep","endplates"]},
    "polyline_recess": {"uses":["panel_gap","door_recess","bumper_recess"],"parameters":["points","width","depth"]},
    "lens_cluster": {"uses":["headlamp","tail_lamp"],"parameters":["boundary","segments","offsets","depth"]}
  },
  "materials": ["paint_red","paint_white","paint_yellow","matte_black","carbon","grille_mesh","lamp_lens","glass","metal","rubber"],
  "forbiddenTargets": ["camera_system","track_pose","steering","vehicle_dynamics","telemetry","licensed_shell_transform","controller_logic"],
  "validation": ["finite_geometry","bounded_vertex_count","semantic_attachment","no_protected_target","multiview_owner_evidence","mobile_budget","no_z_fighting_proxy","symmetry_policy"],
  "promotion": {"requiresVisualTournament":true,"requiresFullResolution":true,"requiresTemporal":true,"requiresMobile":true,"requiresNoProtectedRegression":true}
}
