{
  "schema": 1,
  "name": "Nickelle Advanced Graphics Intelligence",
  "mode": "continuous_safe_self_reconstruction",
  "ownerTruthPrimary": true,
  "optimizer": {
    "type": "bounded_coordinate_gradient",
    "learningRate": 0.22,
    "maxParametersPerCycle": 6,
    "minimumExpectedGain": 0.015
  },
  "implicitSurface": {
    "representation": "multiview_feature_conditioned_sdf_proxy",
    "latentDimensions": 32,
    "gridResolution": [24, 12, 40],
    "meshingTarget": "bounded_topology_dsl"
  },
  "uncertainty": {
    "ownerMultiViewFloor": 0.12,
    "singleViewFloor": 0.34,
    "generatedInferenceFloor": 0.58,
    "protectBelow": 0.18
  },
  "informationGain": {
    "crossViewWeight": 0.42,
    "debtWeight": 0.38,
    "uncertaintyWeight": 0.20
  },
  "critics": {
    "adversarialWeight": 0.55,
    "photorealismWeight": 0.45,
    "minimumPass": 0.58
  },
  "crossResolution": {
    "scales": [1.0, 0.66, 0.42, 0.28],
    "minimumIdentity": 0.86
  },
  "dependencyGraph": {
    "front_fascia": ["headlights", "grille", "front_arches", "splitter", "hood_vents"],
    "front_arches": ["front_fascia", "wheelFill", "side_body", "splitter"],
    "side_body": ["front_arches", "rear_body", "livery", "roof"],
    "rear_body": ["rear_lamps", "rear_wing", "rear_diffuser", "side_body"],
    "hood_roof": ["front_fascia", "roof_scoop", "greenhouse"],
    "materials_livery": ["front_fascia", "side_body", "rear_body", "hood_roof"]
  },
  "meshSurgery": {
    "allowed": ["cut_region", "insert_loop", "local_extrude", "local_recess", "weld", "retopologize_local", "bridge", "bevel"],
    "maxOperationsPerCandidate": 4,
    "mustRemainInsideSemanticComponent": true,
    "requireTopologyGate": true
  },
  "diversity": {
    "lineages": ["owner_accuracy", "mobile_efficiency", "photorealism", "topology_exploration"],
    "minimumDistinctLineages": 3,
    "synthesisInterval": 8
  },
  "replay": {
    "maxNegativeExamples": 120,
    "hardNegativeWeight": 1.4
  },
  "calibration": {
    "cacheOwnerPhotos": true,
    "fields": ["matchedView", "aspect", "crop", "exposure", "occlusion", "componentCoverage", "confidence"]
  },
  "introspection": {
    "enabled": true,
    "fields": ["meshAuthority", "ancestry", "parameters", "triangleBudget", "ownerReferences", "confidence", "lastDecision"]
  },
  "resourceGovernor": {
    "lightDebtThreshold": 0.12,
    "heavyDebtThreshold": 0.30,
    "topologyHeavyThreshold": 1,
    "modes": ["light_parameter", "standard_multiview", "heavy_topology"]
  },
  "convergence": {
    "window": 6,
    "minimumImprovement": 0.006,
    "cooldownCycles": 4
  },
  "realityGap": {
    "weights": {
      "geometry": 0.31,
      "proportions": 0.19,
      "livery": 0.12,
      "materials": 0.10,
      "interiorFit": 0.08,
      "temporal": 0.08,
      "mobile": 0.07,
      "photorealism": 0.05
    }
  },
  "vocabularyExpansion": {
    "minimumRepeatedNeed": 3,
    "requireIsolationTest": true,
    "autoActivate": false
  },
  "syntheticViews": {
    "pairs": [["front", "three"], ["three", "side"], ["side", "rear"], ["rear", "top"]],
    "fractions": [0.25, 0.5, 0.75],
    "minimumConsistency": 0.78
  },
  "wearLayer": {
    "separateFromCanonicalGeometry": true,
    "classes": ["dust", "mud", "scratches", "tire_deformation", "heat_discoloration"],
    "canonicalTruthAlwaysClean": true
  },
  "benchmark": {
    "name": "Michael Graphics Intelligence Benchmark",
    "minimumPromotionScore": 0.70,
    "dimensions": ["owner_similarity", "topology_correctness", "geometry", "materials", "photorealism", "temporal", "mobile", "lod_identity", "causal_explainability", "protected_invariants"]
  }
}
