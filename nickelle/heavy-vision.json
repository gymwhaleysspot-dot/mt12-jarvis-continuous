{
  "schema": 1,
  "name": "Nickelle Heavy Vision",
  "enabled": true,
  "primaryFor": ["semantic_segmentation", "depth_normal_prediction"],
  "segmentation": {
    "model": "Xenova/segformer-b5-finetuned-ade-640-640",
    "architecture": "SegFormer-B5",
    "input": 640,
    "quantization": "q8",
    "fallback": "nickelle_graphics_lab semantic proxy"
  },
  "depth": {
    "model": "onnx-community/depth-anything-v2-base",
    "architecture": "Depth Anything V2 Base / DINOv2 backbone",
    "quantization": "q8",
    "fallback": "nickelle_graphics_lab gradient depth-normal proxy"
  },
  "execution": {
    "location": "GitHub Actions only",
    "liveMobileRenderer": false,
    "championAndEliteOnly": true,
    "cacheModels": true,
    "failurePolicy": "fallback_without_promotion_authority"
  },
  "promotion": {
    "requiredWhenAvailable": true,
    "maxPenalty": 1.25,
    "mayOverrideProtectedGeometryRegression": false
  }
}
